{
	"name": "tag-aggregator",
	"version": "0.1.0",
	"description": "Aggregate all content associated with a tag into a single ephemeral, read-only view.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"install-to-vault": "npm run build && node scripts/install-to-vault.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Jeremy Swinarton",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.10.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.24.0",
		"obsidian": "latest",
		"tslib": "^2.8.0",
		"typescript": "^5.7.0",
		"vitest": "^2.1.0"
	}
}
